configuration {
    modes: "drun,run,window";
    show-icons: true;
    terminal: "kitty";
    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    display-drun: "  Apps ";
    display-run: "  Run ";
    display-window: " 󰙀 Window ";
    sidebar-mode: true;
    window-format: "{w} | {c} | {t}";
    cycle: false;
}

window {
    background-color: #000000;
    border: 2px;
    border-color: #ffffff;
    border-radius: 10px;
}

@theme "vertical"
